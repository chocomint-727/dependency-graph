[gd_resource type="Shader" format=3 uid="uid://bo08uhcxg2foo"]

[resource]
code = "shader_type canvas_item;

uniform float blur_amount : hint_range(0.0, 10.0) = 7.0;
uniform float brightness_scale : hint_range(0.0, 1.0) = 0.8;
uniform sampler2D SCREEN_TEXTURE: hint_screen_texture, filter_linear_mipmap;

void fragment() {
    vec4 color = vec4(0.0);
    vec2 pixel_size = SCREEN_PIXEL_SIZE * blur_amount;

    // simple 9-tap box blur
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            color += texture(SCREEN_TEXTURE, SCREEN_UV + vec2(float(x), float(y)) * pixel_size);
        }
    }
    color /= 9.0;

    COLOR = vec4(color.rgb * brightness_scale, 1.0);
}"
